// Secrets.example.xcconfig — テンプレート（コミットする）
//
// 本番リリース時の手順:
//   1. このファイルをコピーして Secrets.xcconfig を作成
//        cp Secrets.example.xcconfig Secrets.xcconfig
//   2. 下記2つの値を本番のAdMob IDに書き換える
//   3. Secrets.xcconfig は .gitignore 済みなのでコミットされない
//
// 本番IDは AdMob 管理画面（https://apps.admob.com/）で発行:
//   アプリID         : アプリ設定 > アプリID（ca-app-pub-XXXX~YYYY）
//   バナーユニットID  : 広告ユニット > バナー（ca-app-pub-XXXX/ZZZZ）

ADMOB_APP_ID = ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
ADMOB_BANNER_UNIT_ID = ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ

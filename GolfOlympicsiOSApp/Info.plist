<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- AdMob アプリID。Config.xcconfig / Secrets.xcconfig の ADMOB_APP_ID から注入。 -->
	<key>GADApplicationIdentifier</key>
	<string>$(ADMOB_APP_ID)</string>
	<!-- バナー広告ユニットID。ADMOB_BANNER_UNIT_ID から注入し、Release時に AdConfig が読み取る。 -->
	<key>GADBannerAdUnitID</key>
	<string>$(ADMOB_BANNER_UNIT_ID)</string>
	<!-- ATT（App Tracking Transparency）許可ダイアログに表示する説明文。
	     AdMob を使うアプリは App Store 審査で必須。 -->
	<key>NSUserTrackingUsageDescription</key>
	<string>広告のパーソナライズのために、あなたのデータが使用されます。</string>
	<!-- 広告計測用の SKAdNetwork ID。下記は Google AdMob のID。
	     広告収益の計測精度を上げるには、Google提供の全ネットワークIDを追加することを推奨:
	     https://developers.google.com/admob/ios/3p-skadnetworks -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
</dict>
</plist>
